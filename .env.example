# Innomatrics CRM - Backend Environment Template (Sample for Deployment)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/innomatrics_crm
JWT_SECRET=your_production_secure_jwt_secret_key_here_minimum_32_chars
JWT_EXPIRE=7d
NODE_ENV=production

# Isolated E2E test database (separate Atlas database — never use production DB)
TEST_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/innomatrics_e2e

# Frontend Client URL allowed for CORS (e.g., https://innomatrics-crm.vercel.app)
CLIENT_URL=https://your-frontend-deployment-url.vercel.app
