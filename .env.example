# Innomatrics CRM - Backend Environment Template (Sample for Deployment)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>
JWT_SECRET=your_production_secure_jwt_secret_key_here
JWT_EXPIRE=7d
NODE_ENV=production

# Frontend Client URL allowed for CORS (e.g., https://innomatrics-crm.vercel.app)
CLIENT_URL=https://your-frontend-deployment-url.vercel.app
